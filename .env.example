# Copy to .env. Everything here is optional.
# BLOOM_PORT=8787
# Address your Macs use to reach this server, e.g. http://192.168.1.20:8787 or https://ledger.example.com
# BLOOM_LEDGER_LAN_URL=
# Time zone for time-of-use electricity prices only. Days and months are always UTC (like Darkbloom). Example: America/Chicago
# BLOOM_TIMEZONE=
# Login is required for changes by default. Set to "off" only on a trusted private network.
# BLOOM_AUTH=
# Resell-tracker export API (off by default)
# BLOOM_ENABLE_EXPORT_API=
# Optional BloomGauge integration (off by default). Not needed for anything else.
# BLOOM_BLOOMGAUGE=
# Alerts
# ALERT_WEBHOOK_URL=
# PUSHOVER_TOKEN=
# PUSHOVER_USER=
# Hour of the UTC day (0-23) when yesterday's UTC-day push is sent. This is UTC, not local time (it used to be local).
# DAILY_PUSH_HOUR=9
